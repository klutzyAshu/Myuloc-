<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/track_card"
    style="@style/Widget.App.CapsuleCard"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="6dp"
    app:cardElevation="0dp"
    app:rippleColor="#22FFFFFF">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="14dp">

        <!-- Custom high-contrast round image placeholder for album art / symbol -->
        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/img_track_art"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:scaleType="centerCrop"
            android:src="@android:drawable/ic_media_play"
            app:tint="@color/accent_berry_pink"
            android:background="#2E1D24"
            app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Full"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginStart="14dp"
            android:layout_marginEnd="14dp"
            app:layout_constraintStart_toEndOf="@+id/img_track_art"
            app:layout_constraintEnd_toStartOf="@+id/btn_action_play"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent">

            <TextView
                android:id="@+id/txt_track_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Track Title"
                android:textColor="@color/text_primary"
                android:textSize="15sp"
                android:fontFamily="sans-serif-medium"
                android:ellipsize="end"
                android:singleLine="true" />

            <TextView
                android:id="@+id/txt_track_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Artist • Album"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:ellipsize="end"
                android:singleLine="true" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_action_play"
            style="@style/Widget.Material3.Button.IconButton"
            android:layout_width="36dp"
            android:layout_height="36dp"
            app:icon="@android:drawable/ic_media_play"
            app:iconTint="@color/accent_berry_pink"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>
