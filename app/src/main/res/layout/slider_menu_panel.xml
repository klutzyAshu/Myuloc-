<?xml version="1.0" encoding="utf-8"?>
<!-- 
  Redesigned & Optimized Slider Menu Panel with "Pinkish-Black" Theme
  Crafted by Senior Android UI/UX Developer.
  Uses modern AndroidX Material 3 components and flat ConstraintLayout hierarchy.
-->
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root_capsule_container"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="16dp"
    app:cardCornerRadius="28dp"
    app:cardElevation="8dp"
    app:strokeWidth="1dp"
    app:strokeColor="#221B20"
    app:cardBackgroundColor="#130F11"
    android:theme="@style/Theme.Material3.Dark">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="20dp">

        <!-- ========================================== -->
        <!-- COMPONENT A: Dynamic Shuffle Interval Slider -->
        <!-- ========================================== -->
        
        <ImageView
            android:id="@+id/icon_shuffle"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:contentDescription="Shuffle Icon"
            android:src="@android:drawable/ic_menu_compass"
            app:layout_constraintBottom_toTopOf="@+id/shuffle_slider"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="#D4A5B8" />

        <TextView
            android:id="@+id/title_shuffle_interval"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="10dp"
            android:fontFamily="sans-serif-medium"
            android:text="Dynamic Shuffle Interval"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            app:layout_constraintBottom_toTopOf="@+id/shuffle_slider"
            app:layout_constraintEnd_toStartOf="@+id/value_shuffle_interval"
            app:layout_constraintStart_toEndOf="@+id/icon_shuffle"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/value_shuffle_interval"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-black"
            android:text="5 Songs"
            android:textColor="#D4A5B8"
            android:textSize="14sp"
            app:layout_constraintBottom_toTopOf="@+id/shuffle_slider"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <com.google.android.material.slider.Slider
            android:id="@+id/shuffle_slider"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:valueFrom="1.0"
            android:valueTo="30.0"
            android:value="5.0"
            android:stepSize="1.0"
            app:haloColor="#33D4A5B8"
            app:thumbColor="#D4A5B8"
            app:trackColorActive="#D4A5B8"
            app:trackColorInactive="#2A2027"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/title_shuffle_interval"
            app:layout_constraintBottom_toBottomOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>
